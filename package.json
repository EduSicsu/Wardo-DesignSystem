{
  "name": "@wardo/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wardo React components, design tokens, and Figma Code Connect mappings",
  "files": [
    "dist",
    "tokens",
    "figma"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json && cp src/styles/styles.css dist/styles.css",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run build:demo",
    "figma:check": "node scripts/check-mappings.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@figma/code-connect": "^2.1.0",
    "@fontsource-variable/geologica": "^5.2.0",
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react-aria-components": "^1.22.1"
  }
}
